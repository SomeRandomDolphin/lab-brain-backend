# .env.example — copy to .env and fill in your values
# Never commit .env to version control.

# Supabase (required for cloud persistence)
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key>

# Supabase Postgres connection string — used by Alembic (app/db/migrations.py)
# to run schema migrations. Find it under Project Settings → Database →
# Connection string ("URI" tab) in the Supabase dashboard, then swap the
# postgresql:// prefix for postgresql+asyncpg://.
# Required for migrations to run on startup and for POST /supabase/migrations/run;
# if unset, migrations are skipped with a warning instead of failing to boot.
SUPABASE_DB_URL=postgresql+asyncpg://postgres:<your-db-password>@localhost:5432/postgres

# HuggingFace token (required for pyannote speaker diarization)
HF_TOKEN=hf_...

# Auth
FRONTEND_URL=http://localhost:5173     # used in password-reset email links

# SMTP (leave SMTP_HOST empty to log reset links to console instead of sending)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@labbrain.local
