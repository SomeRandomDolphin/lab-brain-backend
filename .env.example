# .env.example — copy to .env and fill in your values
# Never commit .env to version control.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Matches KONG_HTTP_PORT=8080 on your self-hosted stack.
SUPABASE_URL=http://your.supabase.ip:8080/

# = SERVICE_ROLE_KEY in your Supabase docker-compose .env. Already correct.
SUPABASE_SERVICE_KEY=your-service-role-key

# Password portion matches POSTGRES_PASSWORD. Already correct.
SUPABASE_DB_URL=postgresql+asyncpg://postgres:your-postgres-password@your-supabase-ip:5432/postgres

# ── S3-compatible Storage (LiveKit Egress uploads) ────────────────────────────
# CORRECTED to match your actual docker-compose .env — the previous values
# you had (92791bfe.../80e4b824...) belong to a different/stale stack and
# would be rejected by Storage.
S3_PROTOCOL_ACCESS_KEY_ID=your-s3-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=your-s3-access-key-secret

# TODO: create this bucket in Studio (or via the Storage API) before enabling
# egress — GLOBAL_S3_BUCKET=stub in the compose file is Storage's own backing
# store, NOT a real bucket name. Suggest making it private, not public, given
# it will hold raw meeting audio/video.
S3_BUCKET=recordings

# ── LiveKit ───────────────────────────────────────────────────────────────────
# TODO: fill in your actual self-hosted LiveKit values — url/api_key/api_secret
# below are still the docs' dev placeholders and won't work against a real
# deployment. Match whatever your LiveKit server's own config/compose has.
LIVEKIT_URL=ws://your.livekit.ip:7880
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Set to true once the bucket exists and LIVEKIT_API_KEY/SECRET above are real.
LIVEKIT_EGRESS_ENABLED=true

# ── HuggingFace (pyannote speaker diarization) ────────────────────────────────
HF_TOKEN=your-huggingface-token

# ── Auth (this app's own, separate from Supabase Auth's internal mailer) ─────
FRONTEND_URL=http://localhost:5173

# ── SMTP (this app's own password-reset emails — NOT supabase-mail above) ───
# TODO: these are still doc placeholders. Leave SMTP_HOST blank to log reset
# links to console instead of sending real email, or fill in a real provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@labbrain.local