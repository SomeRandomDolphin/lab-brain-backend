# .env.example — copy this to .env and fill in your values. Never commit
# the real .env with actual secrets.

# ── App / Server ───────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
FRONTEND_URL=http://your-frontend-ip:5173

# ── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=http://your.supabase.ip:8080/
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql+asyncpg://postgres:your-postgres-password@your-supabase-ip:5432/postgres
SUPABASE_STORE_AUDIO=true
SUPABASE_STORE_VISION=false

# ── LiveKit ────────────────────────────────────────────────────────────────
LIVEKIT_URL=ws://your.livekit.ip:7880
LIVEKIT_PUBLIC_URL=wss://your.public-or-tailscale-host:7443
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_NODE_IP=your.livekit-node-ip
LIVEKIT_EGRESS_ENABLED=true

# ── Egress recordings container (must match backend image's appuser) ───────
RECORDINGS_APPUSER_UID=1000
RECORDINGS_APPUSER_GID=1000

# ── Local LLM (Ollama-compatible) ───────────────────────────────────────────
LOCAL_LLM_BASE_URL=http://your.local.llm.ip:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_HF_TOKEN=your-huggingface-token
LOCAL_LLM_VISION_MODEL=qwen3-vl:4b
LOCAL_LLM_DIALOGUE_MODEL=qwen3:4b
LOCAL_LLM_EMBEDDING_MODEL=qwen3-embedding:0.6b
LOCAL_LLM_EXTRA_MODEL=hermes3:3b

# ── kg-agent (shared literature-QA service on citi-condor) ─────────────────
KG_AGENT_ENABLED=true
KG_AGENT_BASE_URL=http://your.kg-agent.ip:8003
KG_AGENT_REQUEST_TIMEOUT_SECONDS=300.0
KG_AGENT_SOFT_DEADLINE_SECONDS=6.0
KG_AGENT_FAITHFULNESS_THRESHOLD=0.7
KG_AGENT_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# ── Whisper (speech-to-text) ────────────────────────────────────────────────
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE=en
WHISPER_CPU_THREADS=8
WHISPER_NUM_WORKERS=2

# ── VAD (voice activity detection) ──────────────────────────────────────────
VAD_SAMPLE_RATE=16000
VAD_SILENCE_THRESHOLD=0.03
VAD_SILENCE_CHUNKS=40
VAD_MAX_SEGMENT_CHUNKS=1000

# ── Vision (camera capture) ─────────────────────────────────────────────────
VISION_FRAME_INTERVAL=5
VISION_CAMERA_FPS=5
VISION_CAMERA_QUALITY=0.6

# ── Dialogue ─────────────────────────────────────────────────────────────────
DIALOGUE_CONTEXT_WINDOW=12
DIALOGUE_TTS_AUTO_HIDE_MS=8000

# ── lkc (session-transcript retrieval) ──────────────────────────────────────
LKC_RETRIEVAL_TOP_K=4

# ── spaCy (NER) ──────────────────────────────────────────────────────────────
SPACY_MODEL=en_core_web_sm

# ── SMTP (this app's own password-reset emails — NOT supabase-mail) ────────
SMTP_HOST=your.smtp.host
SMTP_PORT=your-smtp-port
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-smtp-from-address